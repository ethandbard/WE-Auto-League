{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:create": "tsx src/db/create.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/scripts/seed.ts",
    "scheduler": "tsx src/scripts/run-scheduler.ts",
    "mcp": "tsx src/scripts/run-mcp.ts",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:integration": "cross-env DATABASE_URL=postgres://postgres@localhost:5432/we_auto_league_itest AUTH_PROVIDER=session EMAIL_PROVIDER=console node --import tsx --test --test-concurrency=1 test/integration/auth.itest.ts test/integration/corrections.itest.ts test/integration/middleware.itest.ts test/integration/scheduler.itest.ts test/integration/submissions.itest.ts",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "luxon": "^3.5.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
