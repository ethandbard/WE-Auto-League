# Copy to .env and fill in. Read by server/src/env.ts (and, separately, by
# server/drizzle.config.ts — see CLAUDE.md Gotchas for why the two don't share
# one loader).

# Either set DATABASE_URL directly, or leave it unset and the discrete PG*
# vars below are assembled into one.
# DATABASE_URL=postgres://we_auto_league:devpassword@localhost:5432/we_auto_league

PGHOST=localhost
PGPORT=5432
PGDATABASE=we_auto_league
PGUSER=we_auto_league
PGPASSWORD=devpassword
# Azure/managed Postgres requires TLS; a local dev server usually does not.
PGSSL=false

API_PORT=4000
CORS_ORIGIN=http://localhost:5173
# The scheduler (late-penalty checks, reminders, standings mail) runs inside
# this process by default. Set to false to run it as a separate process via
# `npm run scheduler` instead.
ENABLE_SCHEDULER=true

# Magic-link sessions (Phase 1 auth). A long random string in production —
# the server refuses to start with this placeholder when NODE_ENV=production.
AUTH_SECRET=dev-only-change-me
AUTH_SESSION_DAYS=30
# The app's public base URL, used to build magic-link URLs in email.
APP_BASE_URL=http://localhost:5173

# Cloudflare Access (AUTH_PROVIDER=cloudflare-access only). Both are required
# in production: without them the server refuses to start, and outside
# production it falls back to the unverified identity header with a warning.
# CF_ACCESS_TEAM_DOMAIN is the Zero Trust team domain, and also the Access
# JWT's issuer. CF_ACCESS_AUD is the Access application's Application Audience
# (AUD) tag — Zero Trust → Access → Applications → the app → Overview.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Email. Leave every credential empty for the console transport (nothing is
# actually sent — the default for local dev and CI).
# EMAIL_PROVIDER pins one transport: resend | cloudflare | console. Leave empty
# to auto-detect from whichever credential below is set, Resend first.
EMAIL_PROVIDER=
EMAIL_FROM=standings@mail.auto.ethandbard.com

# Resend (production default). Verify the sending domain in the Resend
# dashboard first — it issues the SPF/DKIM records to add.
RESEND_API_KEY=

# Cloudflare Email Sending — alternative transport. Needs the Workers Paid
# plan on the account. See TODO.md item 1.
CF_EMAIL_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
