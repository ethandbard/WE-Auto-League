# Compose env_file template. Copy to config.env (git-ignored) for the VPS deploy.
NODE_ENV=production
POSTGRES_PASSWORD=changeme-in-production
DATABASE_URL=postgres://we_auto_league:changeme-in-production@db:5432/we_auto_league
PGSSL=false
API_PORT=4000
CORS_ORIGIN=https://auto.ethandbard.com
ENABLE_SCHEDULER=true
# session = magic-link cookies (needs working email in production).
# cloudflare-access = trust Cf-Access-Authenticated-User-Email from the tunnel.
AUTH_PROVIDER=cloudflare-access
AUTH_SECRET=changeme-in-production
AUTH_SESSION_DAYS=30
APP_BASE_URL=https://auto.ethandbard.com
# resend | cloudflare | console. Empty auto-detects from the credentials below.
EMAIL_PROVIDER=resend
EMAIL_FROM=standings@mail.auto.ethandbard.com
RESEND_API_KEY=
CF_EMAIL_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
